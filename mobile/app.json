{
  "expo": {
    "name": "Lar em Dia",
    "slug": "lar-em-dia",
    "scheme": "laremdia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lar-em-dia-logo.png",
    "ios": {
      "bundleIdentifier": "com.appcond.condominio",
      "supportsTablet": true
    },
    "android": {
      "package": "com.appcond.condominio",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/lar-em-dia-logo.png",
        "backgroundColor": "#F6F8FA"
      }
    },
    "web": {
      "name": "Lar em Dia",
      "shortName": "Lar em Dia",
      "favicon": "./assets/lar-em-dia-logo.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ]
  }
}
