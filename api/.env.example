NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/condominio
PGSSL=false
# Só usados quando PGSSL=true. Por padrão o certificado do servidor é validado;
# defina PGSSL_CA com a CA do provedor se ele não usar uma CA pública reconhecida,
# ou PGSSL_REJECT_UNAUTHORIZED=false como último recurso (não recomendado).
PGSSL_CA=
PGSSL_REJECT_UNAUTHORIZED=
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
APP_WEB_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
# Produção EAS: https://lar-em-dia.expo.app,https://lar-em-dia--*.expo.app
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=APP COND <nao-responda@seudominio.com.br>
EMAIL_REPLY_TO=suporte@seudominio.com.br
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=laremdia.condominio@gmail.com
SMTP_PASS=senha-de-aplicativo-google
INTER_WEBHOOK_SECRET=
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=/data/certs/inter.crt
INTER_KEY_PATH=/data/certs/inter.key
INTER_CERT_PASSPHRASE=
# Cobrança da fatura da plataforma (assinatura mensal dos condomínios) via
# Pix, direto na conta Mercado Pago do dono da plataforma — sem split, sem
# CNPJ. Gerar o Access Token de produção em
# https://www.mercadopago.com.br/developers/panel (conta pode ser pessoa
# física). Sem essas duas variáveis, o e-mail da fatura sai só informativo,
# sem botão de pagamento — nada quebra.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo escolhido por você (qualquer string aleatória), usado na URL do
# webhook: /webhooks/mercadopago/<este-valor>. Sem ele, o endpoint do
# webhook sempre responde 404 e o pagamento fica sem confirmação automática
# (dá pra conferir manualmente no painel do Mercado Pago).
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública desta API (não a do app) — usada só pra montar a
# notification_url acima. Em produção, a URL do Railway.
API_PUBLIC_URL=http://localhost:3000
# Identificação de quem emite o recibo por e-mail (pessoa física, dono da
# plataforma) — sem nota fiscal automática (conta PF), esse recibo por
# e-mail é o documento que o síndico anexa na prestação de contas. Nunca
# versionar o CPF real — preencher só no .env do servidor.
PLATFORM_RECEIPT_OWNER_NAME=
PLATFORM_RECEIPT_OWNER_CPF=
PLATFORM_RECEIPT_OWNER_CITY=
